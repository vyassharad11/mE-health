<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_10"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dp_10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_150"
            android:orientation="vertical"
            android:padding="@dimen/dp_10">

            <com.mE.Health.utility.roundview.RoundedImageView
                android:id="@+id/ivUserSaved"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:rv_cornerRadius="@dimen/dp_10" />

            <com.mE.Health.utility.roundview.RoundLinearLayout
                android:id="@+id/llFile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                app:rv_backgroundColor="@color/semi_transparent"
                app:rv_cornerRadius="@dimen/dp_10">

                <ImageView
                    android:id="@+id/ivFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play_video" />

            </com.mE.Health.utility.roundview.RoundLinearLayout>


        </RelativeLayout>

        <TextView
            android:id="@+id/tvName"
            style="@style/textStyleRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_color_primary"
            android:textSize="@dimen/sp_12"
            android:paddingBottom="@dimen/dp_2"
            android:paddingHorizontal="@dimen/dp_13"
            android:visibility="visible" />
    </LinearLayout>
</androidx.cardview.widget.CardView>