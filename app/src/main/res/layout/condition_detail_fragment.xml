<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/background_color"
    android:orientation="vertical">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_10">


                <TextView
                    style="@style/textStyleBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_10"
                    android:text="@string/detail"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/sp_24" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_15"
                    app:cardCornerRadius="@dimen/dp_8"
                    app:cardElevation="@dimen/dp_3"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tvName"
                                style="@style/textStyleBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_gravity="center_vertical"
                                android:text="Hypertension"
                                android:layout_marginEnd="@dimen/dp_10"
                                android:layout_toLeftOf="@+id/tvStatus"
                                android:layout_centerVertical="true"
                                android:textColor="@color/text_color_primary"
                                android:textSize="@dimen/sp_20" />


                            <com.mE.Health.utility.roundview.RoundTextView
                                android:id="@+id/tvStatus"
                                style="@style/textStyleSemiBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentRight="true"
                                android:layout_gravity="center_vertical"
                                android:paddingHorizontal="@dimen/dp_20"
                                android:paddingVertical="@dimen/dp_5"
                                android:text="@string/active"
                                android:textColor="@color/color_06C270"
                                android:textSize="@dimen/sp_8"
                                app:rv_backgroundColor="@color/color_A06C270"
                                app:rv_isRadiusHalfHeight="true" />

                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_10"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">


                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/textStyleRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/onset"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_14" />

                                    <TextView
                                        android:id="@+id/tvOnsetDate"
                                        style="@style/textStyleSemiBold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:text="01/05/2022"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_16" />

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="right"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/textStyleRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Recorded"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_14" />

                                    <TextView
                                        android:id="@+id/tvRecordedDate"
                                        style="@style/textStyleSemiBold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:text="01/10/2022"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_16" />

                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_15"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.4"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/textStyleRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/category_"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_14" />

                                    <TextView
                                        android:id="@+id/tvCategory"
                                        style="@style/textStyleSemiBold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_16" />

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="right"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/textStyleRegular"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Condition ID"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_14" />

                                    <TextView
                                        android:id="@+id/tvConditionId"
                                        style="@style/textStyleSemiBold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:text="#HYP2022105"
                                        android:textColor="@color/text_color_primary"
                                        android:textSize="@dimen/sp_16" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20">

                    <TextView
                        style="@style/textStyleBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/practitioners"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/sp_22" />

                    <com.mE.Health.utility.roundview.RoundTextView
                        android:id="@+id/tvPractitionersViewAll"
                        style="@style/textStyleSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:visibility="gone"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dp_20"
                        android:paddingVertical="@dimen/dp_5"
                        android:text="@string/view_all"
                        android:textColor="@color/color_FF6605"
                        android:textSize="@dimen/sp_10"
                        app:rv_backgroundColor="@color/color_33FF6605"
                        app:rv_isRadiusHalfHeight="true" />
                </RelativeLayout>

                <com.mE.Health.utility.roundview.RoundLinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginHorizontal="@dimen/dp_10"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_12"
                    app:rv_backgroundColor="@color/white">


                    <com.mE.Health.utility.roundview.RoundedImageView
                        android:layout_width="@dimen/dp_50"
                        android:layout_height="@dimen/dp_50"
                        app:rv_isOval="true"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_user_profile" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPractitionerName"
                            style="@style/textStyleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. John Doe"
                            android:textColor="@color/text_color_orange"
                            android:textSize="@dimen/sp_18" />

                        <TextView
                            android:id="@+id/tvOrganizationName"
                            style="@style/textStyleRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apollo Hospital"
                            android:textColor="@color/text_color_primary"
                            android:textSize="@dimen/sp_14" />
                    </LinearLayout>

                </com.mE.Health.utility.roundview.RoundLinearLayout>

                <RelativeLayout
                    android:id="@+id/rlVitalLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_10"
                    android:layout_marginTop="@dimen/dp_20">

                    <TextView
                        style="@style/textStyleBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vitals"
                        android:textColor="@color/color_333333"
                        android:textSize="@dimen/sp_22" />

                    <com.mE.Health.utility.roundview.RoundTextView
                        android:id="@+id/tvVitalViewAll"
                        style="@style/textStyleSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="@dimen/dp_20"
                        android:paddingVertical="@dimen/dp_5"
                        android:text="@string/view_all"
                        android:textColor="@color/color_FF6605"
                        android:textSize="@dimen/sp_10"
                        app:rv_backgroundColor="@color/color_33FF6605"
                        app:rv_isRadiusHalfHeight="true" />
                </RelativeLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVitals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_condition_vital" />

            </LinearLayout>


            <RelativeLayout
                android:id="@+id/rlLabsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_10">

                <TextView
                    style="@style/textStyleBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/labs"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/sp_22" />

                <com.mE.Health.utility.roundview.RoundTextView
                    android:id="@+id/tvLabsViewAll"
                    style="@style/textStyleSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/view_all"
                    android:textColor="@color/color_FF6605"
                    android:textSize="@dimen/sp_10"
                    app:rv_backgroundColor="@color/color_33FF6605"
                    app:rv_isRadiusHalfHeight="true" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="1"
                android:layout_marginHorizontal="@dimen/dp_10"
                tools:listitem="@layout/item_condition_lab" />

            <RelativeLayout
                android:id="@+id/rlVisitsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_15">

                <TextView
                    style="@style/textStyleBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/visits"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/sp_22" />

                <com.mE.Health.utility.roundview.RoundTextView
                    android:id="@+id/tvVisitsViewAll"
                    style="@style/textStyleSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/view_all"
                    android:textColor="@color/color_FF6605"
                    android:textSize="@dimen/sp_10"
                    app:rv_backgroundColor="@color/color_33FF6605"
                    app:rv_isRadiusHalfHeight="true" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVisits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="2"
                android:layout_marginHorizontal="@dimen/dp_10"
                tools:listitem="@layout/item_condition_visit" />

            <RelativeLayout
                android:id="@+id/rlMedicationsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_20"
                android:layout_marginTop="@dimen/dp_20">

                <TextView
                    style="@style/textStyleBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/medications"
                    android:textColor="@color/color_333333"
                    android:textSize="@dimen/sp_22" />

                <com.mE.Health.utility.roundview.RoundTextView
                    android:id="@+id/tvMedicationViewAll"
                    style="@style/textStyleSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="@dimen/dp_20"
                    android:paddingVertical="@dimen/dp_5"
                    android:text="@string/view_all"
                    android:textColor="@color/color_FF6605"
                    android:textSize="@dimen/sp_10"
                    app:rv_backgroundColor="@color/color_33FF6605"
                    app:rv_isRadiusHalfHeight="true" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="1"
                android:layout_marginHorizontal="@dimen/dp_10"
                tools:listitem="@layout/item_condition_medication" />

            <include
                android:id="@+id/layoutSyncButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_30"
                layout="@layout/layout_sync_share_button" />

            <include
                android:id="@+id/userSavedFileLayout"
                layout="@layout/user_saved_file_layout" />

            <com.mE.Health.utility.roundview.RoundTextView
                style="@style/textStyleSemiBold"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_45"
                android:layout_marginHorizontal="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_50"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/add_related_data"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_17"
                app:rv_backgroundColor="@color/color_FF6605"
                app:rv_isRadiusHalfHeight="true" />

            <include layout="@layout/bottom_view" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>